[Desktop Entry]
Type=Application
Name=Quản lý mạng
Name[en]=Network Manager Tray
Comment=Quản lý proxy, kết nối và route IPv4 từ khay hệ thống
Exec=netmgr tray
Icon=network-wired-symbolic
Terminal=false
Categories=Network;
X-GNOME-Autostart-enabled=true
# Chờ NetworkManager và GNOME Shell (kèm extension appindicator) sẵn sàng.
# Không có độ trễ này thì tray đăng ký lúc watcher chưa tồn tại — vẫn tự đăng ký
# lại được nhờ bus_watch_name, nhưng icon sẽ nhấp nháy lúc đăng nhập.
X-GNOME-Autostart-Delay=3
